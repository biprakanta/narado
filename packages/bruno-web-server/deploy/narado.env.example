# narado settings for deploy/compose.yaml. Copy to narado.env and fill in.
# Keep narado.env out of Git; better, have your platform inject these from its secrets manager.

# Sign-in (any OpenID Connect provider). Redirect URI: https://<domain>/auth/callback
NARADO_OIDC_ISSUER=https://login.example.com/realms/acme
NARADO_OIDC_CLIENT_ID=narado
NARADO_OIDC_CLIENT_SECRET=
NARADO_OIDC_PROVIDER_NAME=Acme SSO
# Optional: only these email domains may sign in
NARADO_ALLOWED_EMAIL_DOMAINS=example.com

# GitHub App (user authorisation). Callback: https://<domain>/auth/github/callback
NARADO_GITHUB_APP_CLIENT_ID=
NARADO_GITHUB_APP_CLIENT_SECRET=
NARADO_GITHUB_APP_SLUG=
# GitLab OAuth application. Redirect URI: https://<domain>/auth/gitlab/callback
NARADO_GITLAB_APP_CLIENT_ID=
NARADO_GITLAB_APP_CLIENT_SECRET=

# Encrypts stored Git tokens: 32 random bytes, base64 (openssl rand -base64 32).
# Without it, a key file is created in the data volume, next to the database.
NARADO_GIT_TOKEN_KEY=

# Git account must use the person's sign-in email: warn | require | off
NARADO_GIT_ACCOUNT_MATCH=warn

# Internal networks requests may reach (CIDRs); everything private is blocked otherwise.
NARADO_ALLOWED_NETWORKS=

# Secrets stores are configured in narado.json in the data volume; their credentials go here,
# for example NARADO_SECRETS_VAULT_ROLE_ID / NARADO_SECRETS_VAULT_SECRET_ID.

# narado desktop: what laptops may send to (any, private-only, allowlist-only).
NARADO_DESKTOP_SEND=any
